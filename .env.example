# Base URL for the TrustUp backend API.
# The frontend normalizes this value: if it does not already end with `/api/v1`,
# the client appends it automatically. You may set either of the following:
#   EXPO_PUBLIC_API_URL=http://localhost:4000
#   EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
#
# Android emulator should use http://10.0.2.2:4000/api/v1 instead of localhost.
# Physical device: use your machine LAN IP, e.g. http://192.168.1.100:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
